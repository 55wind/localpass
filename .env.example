# .env.example 을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)
# 키가 비어 있는 항목은 샘플 데이터 / 미사용으로 동작합니다.

# 한국관광공사 TourAPI 4.0 — data.go.kr 에서 발급한 "디코딩(Decoding)" 키
TOUR_API_KEY=

# 네이버 검색 API (블로그) — NAVER API HUB(네이버 클라우드 콘솔)에서 발급한 Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# AI 작성 판별: local(무료, 기본 — Fast-DetectGPT + Qwen2.5-1.5B) | gptzero(유료) | off
AI_DETECTOR=local
# DETECTOR_MODEL=Qwen/Qwen2.5-1.5B
# GPTZero를 쓸 때만 (AI_DETECTOR=gptzero)
GPTZERO_API_KEY=

# Qwen2.5-7B-Instruct (OpenAI 호환 엔드포인트)
# 기본값: 로컬 Ollama  →  ollama pull qwen2.5:7b-instruct
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=ollama
# Modal 등 원격 GPU는 콜드 스타트(1~2분) 때문에 넉넉히: LLM_TIMEOUT=300
LLM_TIMEOUT=90
# 호스팅으로 바꿀 때 예시 (OpenRouter):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen-2.5-7b-instruct
# LLM_API_KEY=sk-or-...

# 장소당 분석할 블로그 글 수
REVIEWS_PER_PLACE=6
