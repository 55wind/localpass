# .env.example 을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)
# 키가 비어 있는 항목은 샘플 데이터 / 미사용으로 동작합니다.

# 한국관광공사 TourAPI 4.0 — data.go.kr 에서 발급한 "디코딩(Decoding)" 키
TOUR_API_KEY=

# 네이버 검색 오픈API (블로그) — developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# GPTZero — AI 작성 여부 판별 (없으면 Qwen 문체 신호를 보조 지표로만 사용)
GPTZERO_API_KEY=

# Qwen2.5-7B-Instruct (OpenAI 호환 엔드포인트)
# 기본값: 로컬 Ollama  →  ollama pull qwen2.5:7b-instruct
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=ollama
# 호스팅으로 바꿀 때 예시 (OpenRouter):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen-2.5-7b-instruct
# LLM_API_KEY=sk-or-...

# 장소당 분석할 블로그 글 수
REVIEWS_PER_PLACE=6
